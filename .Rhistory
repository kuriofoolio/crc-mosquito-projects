################################################################################
# Mosquito actograms: actual DAM timestamps, calendar dates, 06:00 reference
# Put Monitor13_09_13.txt in the working directory (or set data_dir below).
# Run with source("create_actogram.R") or Rscript create_actogram.R.
# This plot uses base R: no extra packages are required for actograms.
################################################################################
# 1. Configuration -------------------------------------------------------------
data_dir <- "/Users/MAC/Desktop/R_Projects/Actograms_in_Rethomics/TcEight_example"
monitor_file <- "Monitor13_09_13.txt"
output_pdf <- "Monitor13_09_13_actograms.pdf"
dawn_hour <- 6
bin_seconds <- 60  # This uploaded file has one-minute, end-stamped bins.
# UTC preserves the monitor's written wall-clock times without DST conversion;
# it is not a claim that the instrument was physically in the UTC time zone.
clock_tz <- "UTC"
# Default shading uses column 10 (ambient light sensor: 0 dark, 1 light).
# Use "scheduled" only to display an assumed schedule instead of sensor readings.
shading_mode <- "recorded"
scheduled_light_hours <- 12
# FALSE omits the trailing period with no valid readings; interior gaps stay visible.
include_trailing_invalid <- FALSE
run_periodogram <- FALSE
# 2. Read and validate the actual file ------------------------------------------
input_file <- file.path(data_dir, monitor_file)
if (!file.exists(input_file)) {
stop("File not found: ", input_file,
". Set data_dir to the folder containing Monitor13_09_13.txt.")
}
raw <- read.delim(input_file, header = FALSE, sep = "\t", quote = "",
comment.char = "", stringsAsFactors = FALSE,
colClasses = "character", check.names = FALSE)
if (ncol(raw) != 42L) stop("Expected 10 metadata columns and 32 activity columns.")
# Parse English month names independently of the computer's language settings.
date_parts <- strsplit(trimws(raw[[2]]), " +")
if (any(lengths(date_parts) != 3L)) stop("Unrecognised DAM date format.")
date_parts <- do.call(rbind, date_parts)
month_number <- match(tolower(date_parts[, 2]), tolower(month.abb))
year_number <- as.integer(date_parts[, 3])
year_number <- ifelse(year_number < 100, 2000 + year_number, year_number)
date_iso <- sprintf("%04d-%02d-%02d", year_number, month_number,
as.integer(date_parts[, 1]))
timestamp <- as.POSIXct(paste(date_iso, raw[[3]]),
format = "%Y-%m-%d %H:%M:%S", tz = clock_tz)
if (anyNA(timestamp)) stop("Some timestamps could not be parsed.")
if (any(diff(as.numeric(timestamp)) <= 0)) {
stop("Timestamps must be unique and strictly increasing; inspect the input file.")
}
if (any(diff(as.numeric(timestamp)) < bin_seconds)) {
stop("Overlapping bins: check bin_seconds against the recording interval.")
}
status <- as.integer(raw[[4]])
light <- as.integer(raw[[10]])
if (anyNA(status)) stop("Missing or nonnumeric status codes.")
if (any(!raw[[8]] %in% c("Ct", "CT", "0"))) {
stop("This script expects count data (Ct/CT/0) only.")
}
if (any(as.integer(raw[[6]]) != 13L)) stop("Input contains a monitor other than 13.")
activity <- as.matrix(data.frame(lapply(raw[11:42], as.numeric)))
valid <- status == 1L  # Same valid-status rule as damr::read_dam_file.
if (!any(valid)) stop("No valid (status 1) recordings.")
if (anyNA(activity[valid, , drop = FALSE]) ||
any(activity[valid, , drop = FALSE] < 0)) stop("Invalid activity counts.")
if (any(!light[valid] %in% c(0L, 1L))) stop("Unexpected light sensor values.")
# Invalid rows are missing observations, never biological zero activity.
activity[!valid, ] <- NA_real_
light[!valid] <- NA_integer_
stopifnot(shading_mode %in% c("recorded", "scheduled"),
dawn_hour >= 0, dawn_hour < 24,
scheduled_light_hours > 0, scheduled_light_hours < 24)
fmt <- function(x) format(x, "%d %b %Y %H:%M", tz = clock_tz)
cat("File timestamps: ", fmt(min(timestamp)), " to ", fmt(max(timestamp)), "\n", sep = "")
cat("Valid timestamps: ", fmt(min(timestamp[valid])), " to ",
fmt(max(timestamp[valid])), "\n", sep = "")
cat("Status-code counts:\n")
print(table(status))
cat("Invalid rows are excluded from activity and light measurements.\n")
# 3. Dawn-based coordinates ----------------------------------------------------
# DAM timestamps label the END of the preceding bin. Place each one-minute
# activity bar over [timestamp - 60 seconds, timestamp), not one minute later.
first_bin_start <- min(timestamp[valid]) - bin_seconds
last_bin_end <- if (include_trailing_invalid) max(timestamp) else max(timestamp[valid])
origin <- as.POSIXct(paste(format(first_bin_start, "%Y-%m-%d", tz = clock_tz),
sprintf("%02d:00:00", dawn_hour)), tz = clock_tz)
if (origin > first_bin_start) origin <- origin - 86400
start_hours <- as.numeric(difftime(timestamp - bin_seconds, origin, units = "hours"))
end_hours <- as.numeric(difftime(timestamp, origin, units = "hours"))
# Subtract a tiny epsilon so a bin ENDING at dawn belongs to the previous row.
last_day <- floor((as.numeric(difftime(last_bin_end, origin, units = "secs")) - 1e-6) / 86400)
day_index <- 0:last_day
row_dates <- as.Date(origin, tz = clock_tz) + day_index
# 4. Experimental groups: preserve the channel assignments from your script -----
groups <- rep(NA_character_, 32)
groups[c(1, 3, 5, 9, 11, 13, 17, 19, 21, 25, 27, 29)] <- "Female virgin"
groups[c(2, 4, 10, 12, 18, 20, 26, 28)] <- "Male"
groups[c(6, 7, 8, 14, 15, 16, 22, 23, 24, 30, 31, 32)] <- "Mated female"
stopifnot(!anyNA(groups))
# 5. Double-plotted actograms ---------------------------------------------------
# Explicit windows preserve all observations and the final partial day.
# Each row starts at 06:00 on its labelled date and spans the following 48 hours.
# Its right half repeats the next row's left half. No gap filling is performed.
actoplot <- function(animal_number) {
a <- activity[, animal_number]
peak <- max(a, na.rm = TRUE)
if (peak == 0) peak <- 1
plot(NA, xlim = c(0, 48), ylim = c(last_day + 0.6, -0.6),
xaxs = "i", yaxs = "i", axes = FALSE, xlab = "", ylab = "")
for (d in day_index) {
# Pale blue marks unavailable data, including outside the file's coverage.
rect(0, d - 0.45, 48, d + 0.45, col = "#DBEAF2", border = NA)
idx <- which(valid & start_hours < d * 24 + 48 & end_hours > d * 24)
if (!length(idx)) next
left <- pmax(0, start_hours[idx] - d * 24)
right <- pmin(48, end_hours[idx] - d * 24)
if (shading_mode == "recorded") {
background <- ifelse(light[idx] == 0, "grey82", "white")
} else {
background <- ifelse(((left + right) / 2) %% 24 < scheduled_light_hours,
"white", "grey82")
}
rect(left, d - 0.45, right, d + 0.45, col = background, border = NA)
# A fixed linear scale within each mosquito, across all rows; no clipping.
# Counts remain raw beam breaks; only bar heights are normalised for display.
positive <- a[idx] > 0
rect(left[positive], d + 0.40 - 0.8 * a[idx][positive] / peak,
right[positive], d + 0.40, col = "grey20", border = NA)
}
abline(v = seq(0, 48, 4), col = "#CCCCCC", lwd = 0.5)
abline(h = day_index + 0.5, col = "#CCCCCC", lwd = 0.5)
abline(v = 24, col = "grey50", lwd = 1)
axis(1, at = seq(0, 48, 4))
axis(2, at = day_index, labels = format(row_dates, "%d %b %Y"),
las = 1, cex.axis = 0.7, tck = -0.01)
box()
title(main = paste0("Mosquito ", animal_number, "\n", groups[animal_number]),
xlab = sprintf("Time since 06:00 reference (h; 0 = %02d:00)", dawn_hour),
cex.main = 1.1)
mtext("Date at row start", side = 2, line = 6.7, cex = 0.8)
shade_label <- if (shading_mode == "recorded") "Grey: sensor-reported darkness" else
sprintf("Grey: assumed %.0fh light / %.0fh dark schedule", scheduled_light_hours,
24 - scheduled_light_hours)
mtext(paste0(shade_label, " | Blue: unavailable data | Full bar: ", peak,
" counts/min"), side = 1, line = 4, cex = 0.65)
}
write_actograms <- function() {
pdf(output_pdf, width = 11, height = max(6, 2.2 + length(day_index) * 0.23),
onefile = TRUE)
on.exit(dev.off(), add = TRUE)
par(mar = c(5.3, 8, 4.2, 1.2))
for (animal_number in 1:32) actoplot(animal_number)
}
write_actograms()
