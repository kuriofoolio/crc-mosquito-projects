# Put Monitor13_09_13.txt in the working directory (or set data_dir below).
# Run with source("create_actogram.R") or Rscript create_actogram.R.
# This plot uses base R: no extra packages are required for actograms.
################################################################################
# 1. Configuration -------------------------------------------------------------
data_dir <- "Users/MAC/Desktop/R_Projects/Actograms_in_Rethomics/TcEight_example"
monitor_file <- "Monitor13_09_13.txt"
output_pdf <- "Monitor13_09_13_actograms.pdf"
dawn_hour <- 6
bin_seconds <- 60  # This uploaded file has one-minute, end-stamped bins.
# UTC preserves the monitor's written wall-clock times without DST conversion;
# it is not a claim that the instrument was physically in the UTC time zone.
clock_tz <- "UTC"
# Default shading uses column 10 (ambient light sensor: 0 dark, 1 light).
# Use "scheduled" only to display an assumed schedule instead of sensor readings.
shading_mode <- "recorded"
scheduled_light_hours <- 12
# FALSE omits the trailing period with no valid readings; interior gaps stay visible.
include_trailing_invalid <- FALSE
run_periodogram <- FALSE
# 2. Read and validate the actual file ------------------------------------------
input_file <- file.path(data_dir, monitor_file)
if (!file.exists(input_file)) {
