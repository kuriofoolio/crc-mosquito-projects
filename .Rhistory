period_set = 24
) +
ggtitle(
paste0(
"Mosquito ",
this_id,
"\n",
this_group
)
)
# Print plot
print(p)
# Clear temporary object
rm(this_data, p)
# Give R a chance to clean memory
gc(verbose = FALSE)
}
# Close PDF
dev.off()
# 7. Inspect metadata ----------------------------------------------------------
View(
dt28[meta = TRUE]
)
# 8. Estimate period ------------------------------------------------------------
per_dt28 <-
periodogram(
activity,
dt28,
period_range = c(
hours(14),
hours(34)
),
FUN = chi_sq_periodogram,
resample_rate = 1 / mins(5)
)
per_dt28 <- find_peaks(
per_dt28
)
# 9. Generate periodogram ------------------------------------------------------
ggperio(
per_dt28,
aes(
period,
power
)
) +
geom_line() +
geom_peak(
colour = "black"
) +
geom_line(
aes(
y = signif_threshold
),
colour = "red"
) +
theme_classic() +
facet_wrap(
~ id
)
# 10. Example WITH metadata - OLD CODE ----------------------------------------
metadata_Two <- fread(
"./TcycleHons_example/TcycleHons_metadata.csv"
)
TcycleTwo_raw <- link_dam_metadata(
metadata_Two,
result_dir = "./TcycleHons_example/"
)
TcycleTwo <- load_dam(
TcycleTwo_raw
)
TcycleTwo[
,
moving := activity > 0
]
TcycleTwo <- TcycleTwo[
,
t := t - xmv(s_until_baseline)
]
TcycleTwo[
,
uid := 1:.N,
meta = TRUE
]
TcycleTwo[
,
.(id, uid),
meta = TRUE
]
ggetho(
TcycleTwo,
aes(z = moving)
) +
stat_ld_annotations() +
stat_tile_etho() +
scale_x_days(
name = "Time",
breaks = days(1:56)
)
Tc28 <- TcycleTwo[
xmv(photoperiod) == "28h"
]
ggetho(
Tc28,
aes(z = moving)
) +
stat_ld_annotations() +
stat_tile_etho() +
scale_x_days(
name = "Time",
breaks = days(1:56)
)
actoplot(
Tc28,
period_set = 28
)
as.POSIXct(start_time, tz = "UTC") +
max(dt28$t, na.rm = TRUE)
################################################################################
# Mosquito actograms: actual DAM timestamps, calendar dates, 06:00 reference
# Put Monitor13_09_13.txt in the working directory (or set data_dir below).
# Run with source("create_actogram.R") or Rscript create_actogram.R.
# This plot uses base R: no extra packages are required for actograms.
################################################################################
# 1. Configuration -------------------------------------------------------------
data_dir <- "."
monitor_file <- "Monitor13_09_13.txt"
output_pdf <- "Monitor13_09_13_actograms.pdf"
dawn_hour <- 6
bin_seconds <- 60  # This uploaded file has one-minute, end-stamped bins.
# UTC preserves the monitor's written wall-clock times without DST conversion;
# it is not a claim that the instrument was physically in the UTC time zone.
clock_tz <- "UTC"
# Default shading uses column 10 (ambient light sensor: 0 dark, 1 light).
# Use "scheduled" only to display an assumed schedule instead of sensor readings.
shading_mode <- "recorded"
scheduled_light_hours <- 12
# FALSE omits the trailing period with no valid readings; interior gaps stay visible.
include_trailing_invalid <- FALSE
run_periodogram <- FALSE
# 2. Read and validate the actual file ------------------------------------------
input_file <- file.path(data_dir, monitor_file)
if (!file.exists(input_file)) {
stop("File not found: ", input_file,
". Set data_dir to the folder containing Monitor13_09_13.txt.")
}
getwd
getwd()
