for (animal_number in 1:32) actoplot(animal_number)
}
write_actograms()
cat("Saved: ", normalizePath(output_pdf, mustWork = FALSE), "\n", sep = "")
# 6. Optional original periodogram workflow ------------------------------------
# Disabled by default: the actograms above do not need these packages.
# This is exploratory across the whole recording, which includes a light-regime
# change. Select the intended regime separately for biological interpretation.
if (run_periodogram) {
required <- c("damr", "behavr", "zeitgebr", "ggetho", "ggplot2")
missing <- required[!vapply(required, requireNamespace, logical(1), quietly = TRUE)]
if (length(missing)) stop("Install these packages first: ", paste(missing, collapse = ", "))
dt28 <- damr::read_dam_file(input_file, region_id = 1:32,
start_datetime = format(origin, "%Y-%m-%d %H:%M:%S", tz = clock_tz), tz = clock_tz)
per_dt28 <- zeitgebr::periodogram(activity, dt28,
period_range = c(14, 34) * 3600, FUN = zeitgebr::chi_sq_periodogram,
resample_rate = 1 / 300)
per_dt28 <- zeitgebr::find_peaks(per_dt28)
print(ggetho::ggperio(per_dt28, ggplot2::aes(period, power)) +
ggplot2::geom_line() + ggetho::geom_peak(colour = "black") +
ggplot2::geom_line(ggplot2::aes(y = signif_threshold), colour = "red") +
ggplot2::theme_classic() + ggplot2::facet_wrap(~id))
}
# Reference for column 10 and end-of-bin timestamps:
# https://trikinetics.com/Downloads/DAM2%20Data%20Sheet.pdf
# Valid-status filtering follows damr's reader:
# https://github.com/rethomics/damr/blob/master/R/read-dam-file.R
# Removed the unrelated OLD CODE block: it loaded another experiment and would
# error after this file's actograms had already been written.
